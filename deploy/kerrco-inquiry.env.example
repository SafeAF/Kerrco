# Copy to /etc/kerrco-inquiry.env, root-owned mode 0600. Never commit real credentials.
KERRCO_SITE_ORIGIN=https://kerrco.us
KERRCO_INQUIRY_TO=kerrcoenterprises@gmail.com
# Gmail SMTP: see docs/inquiry-form.md. Password remains intentionally blank.
KERRCO_INQUIRY_FROM=kerrcoenterprises@gmail.com
KERRCO_SMTP_HOST=smtp.gmail.com
KERRCO_SMTP_PORT=587
KERRCO_SMTP_SECURITY=starttls
KERRCO_SMTP_USERNAME=kerrcoenterprises@gmail.com
# Use a dedicated Google app password, never the normal Google account password.
KERRCO_SMTP_PASSWORD=
