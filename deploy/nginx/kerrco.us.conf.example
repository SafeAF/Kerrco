# Adapt to the VPS's existing Nginx layout and certificate manager.
# Certificate paths are examples and must exist before nginx -t can pass.
# Keep order.kerrco.us and any other existing server blocks unchanged.
server {
    listen 80;
    server_name kerrco.us;

    # Use the webroot selected by the VPS's certificate-renewal process.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://kerrco.us$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name kerrco.us;

    ssl_certificate /etc/letsencrypt/live/kerrco.us/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kerrco.us/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # This snippet belongs outside the public document root.
    include /etc/nginx/snippets/kerrco-static.conf;
}
